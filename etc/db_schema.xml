<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- Satellite table mapping an IdP identity to a storefront customer. Customers are
         EAV/API entities, so — unlike admin_user, where the subject is a column on the
         table — the link lives in its own table. `sub` is only unique per issuer and one
         provider code may serve several issuers, so an identity is (provider_code, issuer,
         subject_id); website_id (the customer's website) lets per-website accounts each hold
         it. The PK (customer_id, provider_code) allows one identity per provider per customer.
         Rows are removed with their customer via the FK cascade. -->
    <table name="dmlab_customer_sso_subject" resource="default" engine="innodb"
           comment="DmLab Customer SSO subject links">
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"
                comment="Linked customer entity id"/>
        <column xsi:type="varchar" name="provider_code" nullable="false" length="64"
                comment="Active SSO provider code that issued the subject"/>
        <column xsi:type="varchar" name="issuer" nullable="false" length="255" default=""
                comment="IdP issuer (iss); empty on a legacy link until its next login"/>
        <column xsi:type="varchar" name="subject_id" nullable="false" length="255"
                comment="IdP subject identifier (sub claim)"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" default="0"
                comment="Website of the linked customer"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Link creation time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="customer_id"/>
            <column name="provider_code"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="DMLAB_CUSTOMER_SSO_SUBJECT_IDENTITY">
            <column name="provider_code"/>
            <column name="issuer"/>
            <column name="subject_id"/>
            <column name="website_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="DMLAB_CUSTOMER_SSO_SUBJECT_CUSTOMER_ID"
                    table="dmlab_customer_sso_subject" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
