<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLink" name="customer-account-navigation-sso-link">
                <arguments>
                    <argument name="path" xsi:type="string">customersso/account</argument>
                    <argument name="label" xsi:type="string" translate="true">Single Sign-On</argument>
                    <argument name="sortOrder" xsi:type="number">240</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
