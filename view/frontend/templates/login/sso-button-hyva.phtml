<?php if ($block->isAvailable()): ?>
    <?php $iconUrl = $block->getButtonIconUrl(); ?>
    <div class="dmlab-customer-sso my-4">
        <a class="btn btn-secondary w-full justify-center gap-2"
           href="<?= $escaper->escapeUrl($block->getStartUrl()) ?>">
            <?php if ($iconUrl !== null): ?>
                <img class="h-5 w-5" src="<?= $escaper->escapeUrl($iconUrl) ?>" alt="" />
            <?php endif; ?>
            <span><?= $escaper->escapeHtml($block->getButtonLabel()) ?></span>
        </a>
    </div>
<?php endif; ?>
